# Docker Compose project
COMPOSE_PROJECT_NAME=industrial-visual-anomaly-detection

# Published application releases
INFERENCE_SOURCE_REF=v0.3.0
BACKEND_SOURCE_REF=v0.2.0

# Host ports
BACKEND_HOST_PORT=8080
INFERENCE_HOST_PORT=8000

# Model artifact
MODEL_ARTIFACT_HOST_PATH=./runtime-artifacts/mvtec-ad-capsule-320
MODEL_ARTIFACT_CONTAINER_PATH=/runtime-artifacts/mvtec-ad-capsule-320

# Inference runtime
INFERENCE_MEMORY_CHUNK_SIZE=4096
INFERENCE_REQUEST_TIMEOUT_SECONDS=30