# Docker Compose project
COMPOSE_PROJECT_NAME=industrial-visual-anomaly-detection

# Published application releases
INFERENCE_SOURCE_REF=v0.6.0
INFERENCE_IMAGE_TAG=v0.6.0

BACKEND_SOURCE_REF=v0.3.0
BACKEND_IMAGE_TAG=v0.3.0

# Host ports
BACKEND_HOST_PORT=8080
INFERENCE_HOST_PORT=8000

# Model registry and artifacts
MODEL_ARTIFACTS_HOST_PATH=./runtime-artifacts
MODEL_ARTIFACTS_CONTAINER_PATH=/runtime-artifacts
MODEL_REGISTRY_CONTAINER_PATH=/runtime-artifacts/models.json

# Inference runtime
INFERENCE_MEMORY_CHUNK_SIZE=4096
INFERENCE_REQUEST_TIMEOUT_SECONDS=30